# Copy this file to .env and fill in your deployment's values before running the demo.
# This major version verifies V2 trust bases (a release bundle, a genesis entry or a V2
# genesis JSON); testnet2's V1 trust base is not supported. e2e/dev has a development fixture.
UNICITY_GATEWAY=https://your-aggregator.example/
UNICITY_API_KEY=replace-with-your-api-key
UNICITY_TRUSTBASE=/path/to/your/bft-trustbase.bundle.cbor

# Optional:
UNICITY_OUTPUT_DIR=artifacts
